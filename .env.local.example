# ===== Pusher (https://dashboard.pusher.com 에서 앱 생성 후 발급) =====
PUSHER_APP_ID=your_app_id
NEXT_PUBLIC_PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
NEXT_PUBLIC_PUSHER_CLUSTER=ap3

# ===== Vercel KV (Vercel 대시보드 > Storage > KV 생성 시 자동 발급) =====
# vercel env pull .env.local 로 자동으로 채워집니다.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
